{
	"$schema": "https://biomejs.dev/schemas/2.2.6/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["src/routeTree.gen.ts", "src/i18n/locales/*.json"],
			"linter": { "enabled": false },
			"formatter": { "enabled": false },
			"assist": { "enabled": false }
		},
		{
			"includes": [
				"src/pages/home/components/FeaturedSection.tsx",
				"src/pages/home/components/AppsOfTheDaySection.tsx",
				"src/pages/home/components/CategoriesSection.tsx",
				"src/pages/home/Home.tsx",
				"src/pages/categoryApps/CategoryApps.tsx",
				"src/pages/developerProfile/DeveloperProfile.tsx",
				"src/pages/searchResults/SearchResults.tsx"
			],
			"linter": {
				"rules": {
					"suspicious": { "noArrayIndexKey": "off" }
				}
			}
		},
		{
			"includes": [
				"src/routes/_layout.tsx",
				"src/components/NotificationMenu.tsx"
			],
			"linter": {
				"rules": {
					"correctness": { "useUniqueElementIds": "off" }
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
